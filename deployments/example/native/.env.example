# Example environment for harpseal-example-native and its `harpseal` CLI.
# Copy to .env (git-ignored) and fill in; placeholders only, never commit
# real values. Everything here is read from the environment, never TOML.

# Native runtime (see docs/guide/self-hosting.md).
HARPSEAL_DB=harpseal.sqlite3
HARPSEAL_ADDR=127.0.0.1:8080
HARPSEAL_FILES=.harpseal-files
HARPSEAL_EMAIL=smtp
HARPSEAL_SMTP=smtp://localhost:25
HARPSEAL_EMAIL_FROM=Seal Bay University <noreply@sealbay.example>
# RESEND_API_KEY=re_placeholder

# The https origin the Deployment is served at (#109), over `public_url` in
# deployment.toml. Announcement images on chat Cards (the LINE hero, the
# Telegram preview) need it; unset, Cards go out without an image.
# HARPSEAL_PUBLIC_URL=https://students.sealbay.example

# Fake Channel webhook secret (required, non-empty). `change-me` is only a
# placeholder: dev mode refuses it and anything under 16 characters
# (use e.g. `openssl rand -hex 16`).
FAKE_SECRET=change-me
# Dev mode for demos only: captured email and /dev routes. Never in
# production; refused unless HARPSEAL_ADDR is loopback and FAKE_SECRET is
# strong (see above).
# HARPSEAL_DEV_ROUTES=1

# LINE (docs/guide/channels.md). LINE_LIFF_ID is required.
LINE_CHANNEL_SECRET=
LINE_ACCESS_TOKEN=
LINE_LIFF_ID=0000000000-placeholder

# Telegram. TELEGRAM_WEB_APP_URL is required (the Deployment's HTTPS origin).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEB_APP_URL=https://students.sealbay.example
